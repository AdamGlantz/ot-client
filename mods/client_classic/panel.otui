// The right panel's text buttons (Stop, Options, Logout, Skills, Battle,
// VIP, More..): dark with a light edge and white bold text
ClassicPanelButton < UIButton
  font: Verdana Bold-11px-low-space
  color: #f2f2f2
  text-offset: 0 1
  background-color: #161616
  border-width: 1
  border-color: #5e5e5e
  focusable: false

  $hover !disabled:
    background-color: #262626
    border-color: #9a9a9a

  $pressed:
    background-color: #050505
    text-offset: 1 2

  $on:
    color: #f0d070
    border-color: #8a7a40

  $disabled:
    color: #f2f2f288
