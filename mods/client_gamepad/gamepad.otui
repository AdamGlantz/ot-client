// Built from the ot-ui styles (data/styles/50-ot-ui.otui)
GamepadBindRow < UIWidget
  height: 48
  border-width-bottom: 1
  border-color-bottom: #ffffff14
  // the button being pressed on the controller
  $on:
    background-color: #e0b84c30
    border-width: 2
    border-color: $ot-gold

  OtLabel
    id: name
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    text-auto-resize: true

  OtButton
    id: slot
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 4
    width: 140

GamepadBindWindow < OtBackdrop
  id: gamepadBindWindow
  @onEscape: modules.client_gamepad.closeBindWindow()

  OtPanel
    id: panel
    anchors.centerIn: parent
    size: 380 500

    OtTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10
      !text: tr('Game controller')

    OtIconButton
      id: closeX
      anchors.top: parent.top
      anchors.right: parent.right
      !text: 'X'
      @onClick: modules.client_gamepad.closeBindWindow()

    OtHint
      id: status
      anchors.top: closeX.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8

    ScrollablePanel
      id: rows
      anchors.top: status.bottom
      anchors.left: parent.left
      anchors.right: rowsScroll.left
      anchors.bottom: buttons.top
      margin-top: 8
      margin-bottom: 10
      margin-right: 4
      vertical-scrollbar: rowsScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: rowsScroll
      anchors.top: status.bottom
      anchors.bottom: buttons.top
      anchors.right: parent.right
      margin-top: 8
      margin-bottom: 10
      step: 48
      pixels-scroll: true

    UIWidget
      id: buttons
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 40

      OtButtonDanger
        id: reset
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        width: 110
        !text: tr('Defaults')
        @onClick: modules.client_gamepad.resetBindings()

      OtButtonPrimary
        id: close
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        width: 100
        !text: tr('Done')
        @onClick: modules.client_gamepad.closeBindWindow()
