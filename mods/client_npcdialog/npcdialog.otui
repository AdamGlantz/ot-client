// Built from the ot-ui styles (data/styles/50-ot-ui.otui)
NpcDialogButton < OtButton
  height: 36

// One offer in the shop grid: the item and its price
NpcOfferCell < UIWidget
  size: 44 54
  image-source: /images/ui/3pixel_frame_borderimage
  image-border: 3
  focusable: false

  $on:
    border-width: 2
    border-color: $ot-gold
    background-color: #e0b84c30

  Item
    id: item
    size: 34 34
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 2
    phantom: true
    virtual: true

  Label
    id: price
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 2
    text-align: center
    font: $ot-font-label
    color: $ot-gold
    phantom: true

// One destination in the travel list
NpcTravelRow < UIWidget
  height: 36
  image-source: /images/ui/3pixel_frame_borderimage
  image-border: 3
  focusable: false

  $on:
    border-width: 2
    border-color: $ot-gold
    background-color: #e0b84c30

  Label
    id: name
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: $ot-font-label
    color: $ot-text
    phantom: true

  Label
    id: price
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    font: $ot-font-label
    color: $ot-gold
    phantom: true

NpcDialogWindow < MainWindow
  id: npcDialog
  width: 330
  height: 200
  @onEscape: modules.client_npcdialog.dismiss()

  // In the title bar: ends the conversation (Escape only works when the
  // window has focus, and the shop and travel views have no Bye)
  NpcDialogButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: -26
    margin-right: -6
    size: 18 16
    text: x
    text-offset: 0 -1
    @onClick: modules.client_npcdialog.dismiss()

  Panel
    id: content
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    layout:
      type: verticalBox
      fit-children: true
      spacing: 8

    Label
      id: answer
      text-wrap: true
      text-auto-resize: true
      color: $ot-text

    Panel
      id: buttons
      layout:
        type: grid
        cell-size: 94 36
        cell-spacing: 4
        flow: true
        fit-children: true

    // Shop: Buy / Sell tabs, the offers, the chosen one with an amount
    Panel
      id: trade
      visible: false
      layout:
        type: verticalBox
        fit-children: true
        spacing: 6

      Panel
        id: tabs
        height: 36
        layout:
          type: grid
          cell-size: 147 36
          cell-spacing: 4
          flow: true

        NpcDialogButton
          id: buyTab
          !text: tr('Buy')

        NpcDialogButton
          id: sellTab
          !text: tr('Sell')

      ScrollablePanel
        id: offers
        height: 174
        vertical-scrollbar: offersScroll
        layout:
          type: grid
          cell-size: 44 54
          cell-spacing: 4
          flow: true

      Label
        id: money
        height: 14
        font: $ot-font-label
        color: $ot-gold

      VerticalScrollBar
        id: offersScroll
        visible: false
        step: 28
        pixels-scroll: true

      Panel
        id: chosen
        height: 58
        visible: false

        Item
          id: item
          size: 34 34
          anchors.top: parent.top
          anchors.left: parent.left
          virtual: true

        Label
          id: name
          anchors.top: parent.top
          anchors.left: item.right
          anchors.right: parent.right
          margin-left: 8
          font: $ot-font-label
          color: $ot-text-strong

        Label
          id: each
          anchors.top: name.bottom
          anchors.left: name.left
          anchors.right: parent.right
          margin-top: 2
          color: $ot-text-muted

        HorizontalScrollBar
          id: amount
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: total.left
          margin-right: 8
          minimum: 1
          maximum: 100
          step: 1

        Label
          id: warning
          anchors.top: each.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 6
          text-wrap: true
          height: 28
          color: $ot-negative
          visible: false

        CheckBox
          id: skipCapacity
          anchors.top: warning.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 4
          height: 16
          !text: tr('Always buy, do not ask about capacity')
          visible: false

        Label
          id: total
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          width: 110
          text-align: right
          font: $ot-font-label
          color: $ot-gold

    // Travel: the destinations and their prices
    Panel
      id: travel
      visible: false
      layout:
        type: verticalBox
        fit-children: true
        spacing: 3

    Panel
      id: actions
      height: 36
      layout:
        type: grid
        cell-size: 147 36
        cell-spacing: 4
        flow: true

      OtButtonPrimary
        id: confirm
        height: 36
        !text: tr('Confirm')
        visible: false

      NpcDialogButton
        id: back
        !text: tr('Back')
        visible: false
