// The hub (hub.lua), built from the ot-ui styles (data/styles/50-ot-ui.otui)
HubGrid < UIWidget
  layout:
    type: grid
    cell-size: 200 56
    cell-spacing: 8
    flow: true
    fit-children: true

HubBigButton < OtButton
  height: 56

HubLogout < OtButtonDanger
  height: 44
  margin-top: 12
  !text: tr('Logout')

HubSheet < OtBackdrop
  OtPanel
    id: panel
    anchors.centerIn: parent
    size: 500 560

    OtIconButton
      id: back
      anchors.top: parent.top
      anchors.left: parent.left
      width: 90
      visible: false

    OtTitle
      id: title
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 10

    OtIconButton
      id: close
      anchors.top: parent.top
      anchors.right: parent.right
      !text: 'X'

    OtButton
      id: contrast
      anchors.top: parent.top
      anchors.right: close.left
      margin-right: 6
      width: 84
      !text: tr('Contrast')

    OtTabRow
      id: tabs
      anchors.top: close.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      visible: false

    ScrollablePanel
      id: list
      anchors.top: tabs.bottom
      anchors.left: parent.left
      anchors.right: listScroll.left
      anchors.bottom: parent.bottom
      margin-top: 10
      margin-right: 6
      vertical-scrollbar: listScroll
      layout:
        type: verticalBox

    VerticalScrollBar
      id: listScroll
      anchors.top: tabs.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 10
      step: 52
      pixels-scroll: true

HubHelp < OtBackdrop
  OtPanel
    id: box
    anchors.centerIn: parent
    width: 360
    height: 130
    phantom: true

    OtText
      id: text
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      phantom: true

    OtHint
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      !text: tr('Tap to close')
      phantom: true
