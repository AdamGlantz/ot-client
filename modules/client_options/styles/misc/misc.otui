UIWidget
  anchors.fill: parent
  visible: false
  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    height: 22

    OptionCheckBox
      id: autoChaseOverride
      !text: tr('Allow auto chase override')

  SmallReversedQtPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 55
    margin-top: 10
    Label
      text: Client user features profile
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
    ComboBox
      id: profile
      margin-top: 3
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom

  SmallReversedQtPanel
    id: developerToolsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 22
    margin-top: 10
    @onSetup: self:setVisible(not isDeveloperToolsForced())

    OptionCheckBox
      id: developerTools
      !text: tr('Show developer tools (terminal, debug info, OTUI editor)')

  SmallReversedQtPanel
    id: touchModePanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 30
    margin-top: 10
    // set up by the touch layout mod (client_mobile/touchmode.lua)
    visible: false

    Label
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      !text: tr('Layout (reloads the client)')
      text-auto-resize: true

    ComboBox
      id: touchModeBox
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 130

  SmallReversedQtPanel
    id: touchLayoutPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    height: 30
    margin-top: 10
    @onSetup: self:setVisible(g_platform.isMobile())

    Button
      id: editTouchLayout
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 160
      !text: tr('Edit touch layout')
      @onClick: |
        modules.client_options.hide()
        if modules.client_mobile and modules.client_mobile.startEditLayout then
          modules.client_mobile.startEditLayout()
        end
